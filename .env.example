# Copie este arquivo para .env e preencha os valores reais.
# cp .env.example .env

# ===== BANCO DE DADOS (Railway Postgres) =====
# Todas apontam para a mesma instância (schemas/tabelas diferentes por domínio).
# IMPORTANTE: use a URL PÚBLICA (host *.proxy.rlwy.net), não a *.railway.internal
# (essa só funciona dentro da rede privada do Railway).
# Onde achar: Railway -> serviço Postgres -> Settings -> Networking -> TCP Proxy
# (habilite se não existir) -> Variables -> DATABASE_PUBLIC_URL
AUTH_DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:PORTA/railway
ADMIN_DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:PORTA/railway
INTERACTION_DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:PORTA/railway
ROULETTE_DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:PORTA/railway
NOTIFICATIONS_DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:PORTA/railway

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=3
DB_SSLMODE=disable

ENV=development

# ===== API-SPORTS =====
APISPORTS_KEY=
APISPORTS_WC_SEASON=2026

# ===== JWT =====
JWT_SECRET=
JWT_REFRESH_SECRET=

# ===== FRONTEND =====
FRONTEND_URL=http://localhost:3000

# ===== SMTP (Resend) =====
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_TLS=True
MAIL_FROM=admin@example.com

# ===== OAuth Social Login =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FB_CLIENT_ID=
FB_CLIENT_SECRET=
FB_REDIRECT_URI=

# ===== AWS (S3 / CloudFront) =====
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=sa-east-1
AWS_BUCKET=
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_DOMAIN_REKO=
CLOUDFRONT_PUBLIC_KEY_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

# ===== AWS Rekognition (Photo AI) =====
REKOGNITION_REGION=sa-east-1
REKOGNITION_BUCKET=
REKOGNITION_COLLECTION=
S3_FOLDER=rostos/

# ===== Redis =====
# Modo simples (docker-compose.dev.yml, sem redis): deixe REDIS_HOST=redis mesmo assim.
# O app detecta que não conectou e desativa cache/rate-limit sem travar (ver app/infra/redis.py).
# Modo completo (docker-compose.yml, com redis próprio): mantenha como está, o serviço "redis" existe no compose.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
