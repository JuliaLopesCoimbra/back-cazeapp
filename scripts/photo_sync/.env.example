# AWS — mesmas credenciais do backend
AWS_ACCESS_KEY=AKIA...
AWS_SECRET_KEY=...
REKOGNITION_REGION=us-east-2
REKOGNITION_BUCKET=nome-do-seu-bucket

# Google Service Account
GOOGLE_CREDENTIALS_PATH=/etc/photo-sync/credentials.json

# Evento a sincronizar (preencher por evento)
EVENT_ID=42
DRIVE_FOLDER_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# Intervalo entre verificações (segundos)
CHECK_INTERVAL_SECONDS=60

# Onde guardar o estado (quais arquivos já foram processados)
STATE_FILE=/var/lib/photo-sync/state.json

# Heartbeat — monitoramento no dashboard admin
HEARTBEAT_URL=https://n1app.com.br/admin/photo-sync/heartbeat
HEARTBEAT_API_KEY=gere-uma-chave-aleatoria-aqui
SERVER_NAME=producao
